{
  "name": "brothers-outfit-pos-desktop",
  "version": "0.2.1",
  "description": "Brothers Outfit Gallery Windows POS",
  "author": "Brothers Outfit Gallery",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build:web": "npm --prefix .. run build",
    "start": "electron .",
    "package:win": "npm run build:web && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "in.brothersoutfitgallery.pos",
    "productName": "Brothers Outfit POS",
    "directories": {
      "output": "../artifacts/desktop"
    },
    "files": [
      "main.cjs",
      "updates.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "pos-ui"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "nextgentech-in",
      "repo": "Brothers_Outfit_Gallery_POS",
      "private": false
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "Brothers-Outfit-POS-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
