# Local development reads the existing website's .env SERVER-SIDE. No key values are copied.
EXISTING_WEBSITE_ENV=../Brothers_Outfit/brothers/.env
ADMIN_ORIGIN=http://localhost:4310
ADMIN_PORT=4310
ADMIN_HOST=127.0.0.1
# Set the 4-digit login PIN in an ignored local .env file or server secret store.
# ADMIN_PIN=
# ADMIN_SESSION_SECRET= (random 32+ characters for durable hosted sessions)
# ADMIN_PAIRING_ORIGIN=https://brothers-outfit-gallery-pos.vercel.app
# ADMIN_DEVICE_ACCESS=enabled (set disabled before device rollback)
# ADMIN_BUSINESS_WRITES=disabled
# Production: set HTTPS origin and provision these through the hosting secret store.
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Or FIREBASE_SERVICE_ACCOUNT_JSON=
# SESSION_HOURS=8
# TRUST_PROXY_HOPS=0 (set only for the known deployment proxy topology)
# Existing RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, IMAGEKIT_PRIVATE_KEY remain server-only.
# ERP_SYNC_SECRET= (shared only between website server and admin server)
# WA_GRAPH_VERSION= (for example, the supported Graph API version for your Meta account)
# WA_PHONE_NUMBER_ID=
# WA_ACCESS_TOKEN=
# WA_TEMPLATE_NAME= (approved utility template with document header and static body)
# WA_TEMPLATE_LANGUAGE=en_US
# Phase 7 payment reconciliation additionally requires RAZORPAY_WEBHOOK_SECRET.
